SELECT 
    job_title,
      job_location,
      job_posted_date
FROM job_postings_fact
WHERE job_title = 'Data Analyst'
ORDER BY job_posted_date DESC
LIMIT 10;      

SELECT 
      job_title,
      job_location,
      salary_year_avg AS salary
FROM job_postings_fact
WHERE job_title = 'Data Analyst' AND
      salary_year_avg IS NOT NULL
ORDER BY salary DESC
LIMIT 10;

SELECT 
      job_title,
      job_location,
      salary_year_avg
FROM job_postings_fact
WHERE salary_year_avg >= 100000 AND 
      job_location = 'United States'
      AND job_title = 'Data Analyst'
ORDER BY salary_year_avg DESC;      


SELECT 
      job_title,
      job_posted_date,
      salary_year_avg
FROM job_postings_fact
WHERE job_title = 'Data Analyst' AND (salary_year_avg BETWEEN 80000 AND 120000) AND EXTRACT(YEAR from job_posted_date) = 2023
ORDER BY salary_year_avg DESC
LIMIT 10;

SELECT  
       job_location, 
       salary_year_avg,
    job_title,
       job_via
FROM job_postings_fact
WHERE job_title = 'Data Analyst' AND job_work_from_home = TRUE and salary_year_avg IS NOT NULL 
ORDER BY salary_year_avg DESC
LIMIT 10

SELECT 
      job_title,
      job_location,
      salary_year_avg,
      job_work_from_home
FROM job_postings_fact
WHERE job_title = 'Data Analyst' 
       AND salary_year_avg > 80000 
       AND (job_location = 'New York, NY' or job_location = 'Boston, MA')
       AND job_no_degree_mention = TRUE
ORDER BY salary_year_avg DESC
LIMIT 10;     

SELECT job_title, job_location, salary_year_avg
FROM job_postings_fact
WHERE job_title LIKE '%Data%' AND salary_year_avg IS NULL and job_work_from_home = FALSE
ORDER BY job_title
LIMIT 20;

SELECT job_title, job_location, salary_year_avg, job_work_from_home
FROM job_postings_fact
WHERE (job_title LIKE '%Data Analyst%' or job_title LIKE '%Data Scientist%')
      AND (salary_year_avg IS NOT NULL)
      AND job_no_degree_mention = TRUE
      AND (job_work_from_home = true OR job_location = 'United States')
ORDER BY salary_year_avg DESC
LIMIT 15;    

SELECT job_title, COUNT(*) as count_of_postings
FROM job_postings_fact
GROUP BY job_title
HAVING COUNT(*) >= 10
ORDER BY count_of_postings DESC;

SELECT job_title,  AVG(salary_year_avg) 
FROM job_postings_fact
WHERE salary_year_avg IS NOT NULL
GROUP BY job_title
HAVING AVG(salary_year_avg) > 100000
ORDER BY AVG(salary_year_avg) DESC;

SELECT job_title, AVG(salary_year_avg), COUNT(job_title)
FROM job_postings_fact
WHERE salary_year_avg is not null
GROUP BY job_title
HAVING COUNT(job_title) >= 20
ORDER BY AVG(salary_year_avg) DESC
LIMIT 10;

SELECT COUNT(*) as job_postings, company_dim.name
FROM job_postings_fact
LEFT JOIN company_dim ON company_dim.company_id = job_postings_fact.company_id
GROUP BY company_dim.name
ORDER BY job_postings DESC
LIMIT 5;

SELECT AVG(salary_year_avg), company_dim.name
FROM job_postings_fact
LEFT JOIN company_dim on job_postings_fact.company_id = company_dim.company_id
WHERE salary_year_avg IS NOT NULL
GROUP BY company_dim.name
ORDER BY AVG(salary_year_avg) DESC
LIMIT 10;

SELECT job_id, company_dim.name
FROM job_postings_fact
LEFT JOIN company_dim on job_postings_fact.company_id = company_dim.company_id
WHERE job_title = 'Data Analyst'
ORDER BY company_dim.name ASC
LIMIT 20;

SELECT job_id, job_title, company_dim.name
FROM job_postings_fact
INNER JOIN company_dim ON job_postings_fact.company_id = company_dim.company_id
ORDER BY job_id ASC
LIMIT 20;

SELECT job_postings_fact.job_id, job_postings_fact.job_title, company_dim.name, skills_dim.skills
FROM job_postings_fact
LEFT JOIN company_dim ON job_postings_fact.company_id = company_dim.company_id
INNER JOIN skills_job_dim ON job_postings_fact.job_id = skills_job_dim.job_id
INNER JOIN skills_dim ON skills_job_dim.skill_id = skills_dim.skill_id
WHERE job_title = 'Data Analyst' 
      AND skills_dim.skills = 'sql'
ORDER BY job_id ASC
LIMIT 20;      

